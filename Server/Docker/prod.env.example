# Settings for the public deployment (compose.prod.yaml). Copy to prod.env (gitignored) and fill in.
#   cp prod.env.example prod.env

# The VM's public IPv4 address. The servers send it to clients as the address of the game, chat
# and relay servers. On Oracle Cloud it is the instance's "Public IP address", not the 10.x one.
PUBLIC_IP=

# Long random secrets. Generate each one with:  openssl rand -hex 24
# POSTGRES_PASSWORD only takes effect when the database volume is created for the first time.
POSTGRES_PASSWORD=
ADMIN_KEY=

# In-game admin account that `make prod-provision` creates.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Password of the load-test accounts bot0..botN (make prod-provision-bots). Anyone who knows it can
# log in as a bot, so make it random too, and pass it to the load bot as PASSWORD=...
BOT_PASSWORD=

# Optional: a domain pointing at PUBLIC_IP (e.g. status.example.com) gives the status page automatic
# HTTPS. Left empty, Caddy serves plain HTTP on port 80.
STATUS_SITE=
