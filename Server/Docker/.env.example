# Copy to .env (gitignored) for local overrides read by compose.yaml.

# Host port Postgres is published on (127.0.0.1 only). Change it if 5432 is already in use on
# your machine, e.g. by another project's database. The servers always use postgres:5432 inside
# the compose network, so their configs need no change.
# POSTGRES_HOST_PORT=5433
